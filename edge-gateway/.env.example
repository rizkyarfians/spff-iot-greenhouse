SITE_ID=greenhouse-01
DEVICE_ID=esp32-s3-01

SERIAL_ENABLED=false
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD_RATE=115200
SERIAL_MAX_LINE_BYTES=16384
SERIAL_RECONNECT_MIN_MS=1000
SERIAL_RECONNECT_MAX_MS=30000

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=edge-greenhouse-01-esp32-s3-01
MQTT_USERNAME=edge_greenhouse_01
MQTT_PASSWORD=replace-with-generated-password
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_CONNECT_TIMEOUT_MS=30000
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_KEEPALIVE_SECONDS=30

EDGE_OUTBOX_DIR=/var/lib/spff/edge-outbox
EDGE_OUTBOX_MAX_ITEMS=50000
EDGE_OUTBOX_FLUSH_INTERVAL_MS=2000
