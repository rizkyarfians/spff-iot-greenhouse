SPFF_API_READY_URL=http://127.0.0.1:5001/api/ready
SPFF_DATA_PATH=/opt/spff
SPFF_BACKUP_DIR=/var/backups/spff/postgres
SPFF_BACKUP_MAX_AGE_HOURS=30
SPFF_DISK_WARN_PERCENT=85
SPFF_OUTBOX_WARN_COUNT=1000
SPFF_REQUIRED_SERVICES=postgresql spff-mqtt-broker spff-mqtt-worker spff-edge-gateway spff-api
DATABASE_URL=postgresql://spff_backup:replace-with-local-password@127.0.0.1:5432/spff
