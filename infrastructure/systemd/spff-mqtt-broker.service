[Unit]
Description=SPFF local Mosquitto broker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/spff
ExecStart=/usr/bin/docker compose --env-file /opt/spff/infrastructure/mqtt/.env -f /opt/spff/infrastructure/mqtt/compose.yml up -d --wait
ExecStop=/usr/bin/docker compose --env-file /opt/spff/infrastructure/mqtt/.env -f /opt/spff/infrastructure/mqtt/compose.yml stop
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target