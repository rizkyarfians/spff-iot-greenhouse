[Unit]
Description=SPFF PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=spff
Group=spff
EnvironmentFile=/opt/spff/infrastructure/backup/backup.env
ExecStart=/opt/spff/infrastructure/backup/postgres-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/spff

[Install]
WantedBy=multi-user.target
