# PostgreSQL lokal (source of truth)
DATABASE_URL=postgresql://spff_user:replace-with-password@127.0.0.1:5432/spff
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Mosquitto lokal
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=worker-greenhouse-01-01
MQTT_USERNAME=worker_greenhouse_01
MQTT_PASSWORD=replace-with-generated-password
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_CONNECT_TIMEOUT_MS=30000
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_KEEPALIVE_SECONDS=30

# Outbound command dispatcher (PostgreSQL pending -> MQTT commands)
COMMAND_POLL_INTERVAL_MS=1000
COMMAND_BATCH_SIZE=20

# Schedule evaluator (actuator_schedules -> control_commands pending)
# Keep server during firmware rollout. Change to device only after the ESP32
# persists schedule_sync and returns schedule_sync_ack.
SCHEDULE_EXECUTION_MODE=server
SCHEDULE_POLL_INTERVAL_MS=1000
SCHEDULE_SYNC_POLL_INTERVAL_MS=1000
SCHEDULE_LOOKBACK_SECONDS=120
COMMAND_EXPIRY_SECONDS=30
