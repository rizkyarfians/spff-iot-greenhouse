# Only SHADOW_MODE is accepted. Environment must be loaded by the caller.
EXECUTION_MODE=SHADOW_MODE
# Use a dedicated role with SELECT on existing domain tables and writes ONLY
# to adaptive_ai_* tables. Never use API/worker/owner credentials.
DATABASE_URL=postgresql://spff_ai_shadow:CHANGE_ME@localhost:5432/spff
SITE_ID=site-1
DEVICE_ID=esp32-1
TELEMETRY_MAX_AGE_SECONDS=120
STATUS_MAX_AGE_SECONDS=90
EMA_ALPHA=0.2
MIN_WATER_TANK_PERCENT=25
MIN_FERT_TANK_PERCENT=20
# Membership/rules default to simulation only. No zone liter target without a
# complete referenced calibration. JSON is read directly, NOT a filename.
FUZZY_PROFILE_JSON={}
EMA_MIN_INTERVAL_SECONDS=5
EMA_OUTLIER_FACTOR=3
# Bump only after reviewing changed pump/flow calibration or a reconciled reset.
EMA_PROFILE_REVISION=default-v1
# Default false: absence of session rows is NOT proof of zero physical dosing.
# Enable only after verifying the existing session evidence is exhaustive and
# that there are no unreported manual/firmware/pulse deliveries.
DELIVERY_EVIDENCE_COMPLETE=false
