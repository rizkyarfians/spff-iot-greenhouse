# Independent from SPFF. No existing environment is imported automatically.
AI_HOST=127.0.0.1
AI_PORT=5010
AI_MODE=SHADOW_MODE
AI_CONFIG=config/simulation.json
AI_STATE_PATH=data/shadow.sqlite3
# Required only for the optional read-only SPFF adapter and PostgreSQL state.
AI_SOURCE_DSN=
AI_STATE_DSN=
AI_SITE_ID=greenhouse-01
AI_DEVICE_ID=esp32-s3-01
AI_ZONE_ID=soil-1
AI_POLL_SECONDS=10
AI_POLL_ENABLED=false
# Operator-requested route for fertilizer products; this does not enable ACTIVE.
AI_FERTILIZER_DELIVERY_ROUTE=reference
