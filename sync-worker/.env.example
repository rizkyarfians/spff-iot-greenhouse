FIREBASE_SYNC_ENABLED=false
FIREBASE_PROJECT_ID=your-project-id
# Gunakan Application Default Credentials. Jangan commit service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/opt/spff/secrets/firebase-service-account.json

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=spff
PGUSER=spff_sync
PGPASSWORD=replace-with-strong-password

SYNC_POLL_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
SYNC_LOCK_TIMEOUT_SECONDS=120
SYNC_MAX_ATTEMPTS=12
SYNC_BACKOFF_BASE_MS=2000
SYNC_BACKOFF_MAX_MS=900000
SYNC_RETENTION_DAYS=14
